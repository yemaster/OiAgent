---
import { LinkButton } from '@astrojs/starlight/components';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import WorkspacePreview from './WorkspacePreview.astro';
import { repository, sitePath } from '../lib/links';
const isHome = Astro.locals.starlightRoute.entry.id === '' || Astro.locals.starlightRoute.entry.id === 'index';
---

{isHome ? (
  <div class="home-hero">
    <div class="hero-heading">
      <h1 id="_top" data-page-title>Agent 的<br />桌面工作区</h1>
      <div class="hero-actions">
        <LinkButton href={`${repository}/releases`} icon="download">下载 OiAgent</LinkButton>
        <LinkButton href={sitePath('docs/getting-started/')} variant="secondary" icon="right-arrow">开始使用</LinkButton>
      </div>
    </div>
    <WorkspacePreview />
  </div>
) : <DefaultHero />}

<style>
  .home-hero { padding-top: clamp(2rem, 7vw, 5.5rem); }
  .hero-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  h1 { font-size: clamp(2.5rem, 5.3vw, 4.5rem); font-weight: 600; line-height: 1.18; color: var(--sl-color-white); letter-spacing: normal; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; padding-bottom: .5rem; }
  @media (max-width: 49.99rem) {
    .hero-heading { align-items: start; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem; }
  }
</style>
